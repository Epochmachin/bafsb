#!/bin/sh
# BAFSB privacy guard: stops any commit that could make student data public.
# Enabled once with:  git config core.hooksPath .githooks
fail=0
files=$(git diff --cached --name-only --diff-filter=ACM)
for f in $files; do
  case "$f" in
    *.csv|*.xlsx|*.xls|*.ods|*.pdf|*.keystore|*.jks|bafsb-backup-*|*BAFSB_start*|*Student_Lists*)
      echo "BLOCKED: $f looks like student data / a private file. Keep it out of GitHub."; fail=1 ;;
  esac
  case "$f" in vendor/*) continue ;; esac
  if git show ":$f" 2>/dev/null | grep -Eq '(^|[^0-9])01[3-9][0-9]{8}([^0-9]|$)'; then
    echo "BLOCKED: $f contains a Bangladeshi mobile number. Student data must stay on the phone / your Drive."; fail=1
  fi
done
[ $fail -eq 0 ] || { echo "Commit stopped by the privacy guard."; exit 1; }
exit 0
